<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

  <changeSet id="scim-sync-mapping-1" author="keycloak-scim-client">
    <createTable tableName="SCIM_SYNC_MAPPING">
      <column name="ID" type="VARCHAR(36)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="REALM_ID" type="VARCHAR(36)">
        <constraints nullable="false"/>
      </column>
      <column name="RESOURCE_TYPE" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="KEYCLOAK_ID" type="VARCHAR(36)">
        <constraints nullable="false"/>
      </column>
      <column name="SCIM_ID" type="VARCHAR(64)"/>
      <column name="LAST_SYNC_TIME" type="BIGINT"/>
      <column name="LAST_SYNC_RESULT" type="VARCHAR(16)"/>
      <column name="LAST_SYNC_ERROR" type="VARCHAR(1024)"/>
    </createTable>
    <addUniqueConstraint
        tableName="SCIM_SYNC_MAPPING"
        columnNames="REALM_ID, RESOURCE_TYPE, KEYCLOAK_ID"
        constraintName="UK_SCIM_SYNC_MAPPING_ENTITY"/>
    <createIndex tableName="SCIM_SYNC_MAPPING" indexName="IDX_SCIM_SYNC_MAPPING_SCIM_ID">
      <column name="SCIM_ID"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
