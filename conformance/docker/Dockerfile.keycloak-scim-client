# Builds a real Keycloak 25.0.6 image with our own plugin jar installed, for the
# conformance test (conformance/README.md) -- mirrors mario/scimitar's keycloak-it
# Dockerfile.keycloak-scim, pinned to the same Keycloak version this plugin's pom.xml
# targets, but with OUR jar instead of mitodl's.
FROM quay.io/keycloak/keycloak:25.0.6 AS keycloak-builder
COPY keycloak-scim-client.jar /opt/keycloak/providers/keycloak-scim-client.jar
# `--vault=file` (per `kc.sh build --help`'s "Vault:" section) makes the file-vault
# provider available at build time -- but it must be passed AGAIN at runtime (see
# docker-compose.yml's KC_VAULT/KC_VAULT_DIR) or it never actually gets selected,
# confirmed live via conformance/README.md. `--spi-vault-provider=files-plaintext` is
# not a real option here despite matching the provider's actual getId().
RUN /opt/keycloak/bin/kc.sh build --health-enabled=true --vault=file

FROM quay.io/keycloak/keycloak:25.0.6
COPY --from=keycloak-builder /opt/keycloak/ /opt/keycloak/
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev", "--health-enabled=true"]
